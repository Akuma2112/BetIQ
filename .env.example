# Copy to .env.local (local dev + scripts) and set the same values in Vercel → Project → Settings → Environment Variables.

# --- Supabase (Dashboard → Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Publishable (anon) key — safe in the browser, RLS applies
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret (service-role) key — server/scripts only, bypasses RLS. Never expose.
SUPABASE_SECRET_KEY=sb_secret_xxx

# The only email allowed to sign in (magic link)
OWNER_EMAIL=you@example.com

# --- football-data.org (free: register at https://www.football-data.org/client/register, token arrives by email) ---
FOOTBALL_DATA_ORG_TOKEN=

# --- The Odds API (free 500 credits/month: https://the-odds-api.com → "Get API key") ---
ODDS_API_KEY=
# Your plan's monthly credits; odds jobs stop at 95% of it
ODDS_API_MONTHLY_CREDITS=500

# --- Anthropic (https://console.anthropic.com → API Keys) — analysis layer only ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Shared secret for /api/cron/* — also stored in Supabase Vault as 'cron_secret'.
# Generate: openssl rand -hex 32
CRON_SECRET=

# Public URL of the app (magic-link redirect + pg_cron target, also in Vault as 'site_url')
NEXT_PUBLIC_SITE_URL=http://localhost:3000
